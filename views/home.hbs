<head>
  <link rel="stylesheet" href="/css/home.css" />
</head>

<div class="hero-container fade-in mt-4 mb-5 pt-4 pb-4 px-4 rounded-lg shadow-sm welcome-banner">
  <div class="welcome-icon">
    <img src="/img/crossword-icon.svg" alt="Crossword Icon" onerror="this.src='/img/logo.png'; this.style.width='48px'; this.style.height='48px';" width="64" height="64">
  </div>
  <h1 class="welcome-text">Hello {{name}}, welcome to Crosswordia!</h1>
  <p class="lead">What would you like to do today?</p>
</div>
<div class="container">
  <div class="row row-cols-1 row-cols-md-2 g-4 fade-in">
    <!-- Solve Puzzles Card -->
    <div class="col">
      <a href="/gallery" class="text-decoration-none">
        <div class="option-card">
          <div class="card-img-container">
            <img
              src="/img/crossword-thinking.svg"
              referrerpolicy="no-referrer"
              alt="Solve puzzles"
              width="220"
              height="220"
            />
          </div>
          <div class="card-content text-center">
            <h3 class="card-title">Test Your Skills</h3>
            <p class="card-description">Challenge yourself with our collection
              of premade crosswords ranging from beginner to advanced difficulty
              levels.</p>
            <div class="action-button">
              Browse Gallery
            </div>
          </div>
        </div>
      </a>
    </div>

    <!-- Create Puzzles Card -->
    <div class="col">
      <a href="/create" class="text-decoration-none">
        <div class="option-card">
          <div class="card-img-container">
            <img
              src="/img/create-crossword.svg"
              referrerpolicy="no-referrer"
              alt="Create puzzles"
              width="220"
              height="220"
            />
          </div>
          <div class="card-content text-center">
            <h3 class="card-title">Create Your Own</h3>
            <p class="card-description">Design custom crossword puzzles with our
              intuitive editor and share them with friends or the community.</p>
            <div class="action-button">
              Start Creating
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>

  {{#if user}}
    <!-- User Stats Section (Only shown when logged in) -->
    <div
      class="mt-5 pt-4 pb-4 px-4 rounded-lg shadow-sm fade-in stats-section"
    >
      <h3 class="mb-4 pt-5 text-center journey-title">Your Crossword Journey</h3>
      <div class="stats-container">
        <!-- Puzzles Completed -->
        <div class="stat-item">
          <div class="stat-icon">
            <img src="/img/checkmark.svg" alt="Completed" class="stat-svg" />
          </div>
          <div class="stat-text">
            <span class="stat-label">Puzzles Completed</span>
            <span class="stat-value">{{stats.totalCompleted}}</span>
          </div>
        </div>

        <!-- Puzzles Created -->
        <div class="stat-item">
          <div class="stat-icon">
            <img src="/img/pencil.svg" alt="Created" class="stat-svg" />
          </div>
          <div class="stat-text">
            <span class="stat-label">Puzzles Created</span>
            <span class="stat-value">{{stats.puzzlesCreated}}</span>
          </div>
        </div>

        <!-- Best Time -->
        <div class="stat-item">
          <div class="stat-icon">
            <img src="/img/stopwatch.svg" alt="Time" class="stat-svg" />
          </div>
          <div class="stat-text">
            <span class="stat-label">Best Time</span>
            <span class="stat-value">{{stats.bestTime}}</span>
          </div>
        </div>
      </div>
    </div>
  {{/if}}

  <!-- Add substantial spacing before footer -->
  <div class="mt-3 pt-3"></div>
</div>